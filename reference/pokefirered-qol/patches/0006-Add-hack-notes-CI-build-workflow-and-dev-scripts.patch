--- /dev/null
+++ b/dev_scripts/add_move_categories.py
@@ -0,0 +1,65 @@
+"""Insert a `.category = DAMAGE_CATEGORY_*` line into every gBattleMoves entry.
+
+Classification follows the Gen 4+ physical/special split:
+  - power == 0            -> STATUS
+  - name in SPECIAL_MOVES -> SPECIAL
+  - everything else       -> PHYSICAL
+Usage: python3 -I add_move_categories.py path/to/src/data/battle_moves.h
+"""
+import re
+import sys
+
+SPECIAL_MOVES = {
+    "RAZOR_WIND", "GUST", "SONIC_BOOM", "ACID", "EMBER", "FLAMETHROWER",
+    "WATER_GUN", "HYDRO_PUMP", "SURF", "ICE_BEAM", "BLIZZARD", "PSYBEAM",
+    "BUBBLE_BEAM", "AURORA_BEAM", "HYPER_BEAM", "ABSORB", "MEGA_DRAIN",
+    "SOLAR_BEAM", "PETAL_DANCE", "DRAGON_RAGE", "FIRE_SPIN", "THUNDER_SHOCK",
+    "THUNDERBOLT", "THUNDER", "CONFUSION", "PSYCHIC", "NIGHT_SHADE", "SMOG",
+    "SLUDGE", "FIRE_BLAST", "SWIFT", "DREAM_EATER", "BUBBLE", "PSYWAVE",
+    "TRI_ATTACK", "AEROBLAST", "SNORE", "POWDER_SNOW", "SLUDGE_BOMB",
+    "MUD_SLAP", "OCTAZOOKA", "ZAP_CANNON", "ICY_WIND", "GIGA_DRAIN",
+    "DRAGON_BREATH", "HIDDEN_POWER", "TWISTER", "MIRROR_COAT",
+    "ANCIENT_POWER", "SHADOW_BALL", "FUTURE_SIGHT", "WHIRLPOOL", "UPROAR",
+    "SPIT_UP", "HEAT_WAVE", "ERUPTION", "LUSTER_PURGE", "MIST_BALL",
+    "HYPER_VOICE", "BLAST_BURN", "HYDRO_CANNON", "WEATHER_BALL", "AIR_CUTTER",
+    "OVERHEAT", "SILVER_WIND", "WATER_SPOUT", "SIGNAL_BEAM", "EXTRASENSORY",
+    "SHEER_COLD", "MUDDY_WATER", "FRENZY_PLANT", "MUD_SHOT", "MAGICAL_LEAF",
+    "SHOCK_WAVE", "WATER_PULSE", "DOOM_DESIRE", "PSYCHO_BOOST",
+}
+
+ENTRY_RE = re.compile(r"(    \[MOVE_(\w+)\] =\n    \{\n)(.*?)(\n    \},?)", re.S)
+
+
+def main(path):
+    src = open(path).read()
+    seen = set()
+    counts = {"PHYSICAL": 0, "SPECIAL": 0, "STATUS": 0}
+
+    def repl(m):
+        head, name, body, tail = m.groups()
+        if ".category" in body:
+            raise SystemExit(f"MOVE_{name} already has a category")
+        seen.add(name)
+        power = int(re.search(r"\.power = (\d+)", body).group(1))
+        if power == 0:
+            cat = "STATUS"
+        elif name in SPECIAL_MOVES:
+            cat = "SPECIAL"
+        else:
+            cat = "PHYSICAL"
+        counts[cat] += 1
+        body = re.sub(r"(        \.type = \w+,\n)",
+                      r"\1        .category = DAMAGE_CATEGORY_" + cat + ",\n",
+                      body, count=1)
+        return head + body + tail
+
+    out = ENTRY_RE.sub(repl, src)
+    missing = SPECIAL_MOVES - seen
+    if missing:
+        raise SystemExit(f"Unknown special moves: {sorted(missing)}")
+    open(path, "w").write(out)
+    print(f"tagged {len(seen)} moves: {counts}")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/dev_scripts/gen_headers.py b/dev_scripts/gen_headers.py
new file mode 100644
index 0000000..0f8239c
--- /dev/null
+++ b/dev_scripts/gen_headers.py
@@ -0,0 +1,78 @@
+"""Generate stand-ins for pokefirered's build-generated headers so changed C
+files can be syntax-checked with the host compiler (no decomp tools run).
+
+Writes into <out>/: constants/map_groups.h, constants/layouts.h,
+constants/map_event_ids.h, data/items.h
+Usage: python3 -I gen_headers.py <pokefirered root> <out dir>
+"""
+import json
+import os
+import sys
+
+root, out = sys.argv[1], sys.argv[2]
+os.makedirs(f"{out}/constants", exist_ok=True)
+os.makedirs(f"{out}/data", exist_ok=True)
+
+# map_groups.h
+groups = json.load(open(f"{root}/data/maps/map_groups.json"))
+lines = ["#ifndef GUARD_CONSTANTS_MAP_GROUPS_H", "#define GUARD_CONSTANTS_MAP_GROUPS_H"]
+event_lines = ["#ifndef GUARD_CONSTANTS_MAP_EVENT_IDS_H", "#define GUARD_CONSTANTS_MAP_EVENT_IDS_H"]
+seen_local = set()
+for g, group in enumerate(groups["group_order"]):
+    for n, name in enumerate(groups[group]):
+        m = json.load(open(f"{root}/data/maps/{name}/map.json"))
+        lines.append(f"#define {m['id']} ({n} | ({g} << 8))")
+        for i, obj in enumerate(m.get("object_events", [])):
+            lid = obj.get("local_id")
+            if lid and lid not in seen_local:
+                seen_local.add(lid)
+                event_lines.append(f"#define {lid} {i + 1}")
+lines.append(f"#define MAP_GROUPS_COUNT {len(groups['group_order'])}")
+lines.append("#endif")
+open(f"{out}/constants/map_groups.h", "w").write("\n".join(lines) + "\n")
+event_lines.append("#endif")
+open(f"{out}/constants/map_event_ids.h", "w").write("\n".join(event_lines) + "\n")
+
+# layouts.h
+layouts = json.load(open(f"{root}/data/layouts/layouts.json"))
+lines = ["#ifndef GUARD_CONSTANTS_LAYOUTS_H", "#define GUARD_CONSTANTS_LAYOUTS_H"]
+for i, layout in enumerate(layouts["layouts"]):
+    if layout.get("id"):
+        lines.append(f"#define {layout['id']} {i + 1}")
+lines.append("#endif")
+open(f"{out}/constants/layouts.h", "w").write("\n".join(lines) + "\n")
+
+# data/items.h (mirrors src/data/items.json.txt)
+items = json.load(open(f"{root}/src/data/items.json"))["items"]
+lines = []
+for it in items:
+    if it["pocket"] == "POCKET_TM_CASE":
+        lines.append(f"extern const u8 gMoveDescription_{it['moveId']}[];")
+    if it["itemId"] != "ITEM_NONE":
+        lines.append(f"const u8 gItemDescription_{it['itemId']}[] = _(\"{it['description_english']}\");")
+lines.append('const u8 gItemDescription_ITEM_NONE[] = _("?????");')
+lines.append("const struct Item gItems[] = {")
+for it in items:
+    desc = f"gMoveDescription_{it['moveId']}" if it["pocket"] == "POCKET_TM_CASE" else f"gItemDescription_{it['itemId']}"
+    lines.append(
+        "    {"
+        f".name = _(\"{it['english']}\"), .itemId = {it['itemId']}, .price = {it['price']}, "
+        f".holdEffect = {it['holdEffect']}, .holdEffectParam = {it['holdEffectParam']}, .description = {desc}, "
+        f".importance = {it['importance']}, .registrability = {it['registrability']}, .pocket = {it['pocket']}, "
+        f".type = {it['type']}, .fieldUseFunc = {it['fieldUseFunc']}, .battleUsage = {it['battleUsage']}, "
+        f".battleUseFunc = {it['battleUseFunc']}, .secondaryId = {it['secondaryId']}"
+        "},"
+    )
+lines.append("};")
+open(f"{out}/data/items.h", "w").write("\n".join(lines) + "\n")
+print("generated headers in", out)
+
+# constants/region_map_sections.h (mirrors region_map_sections.constants.json.txt)
+secs = json.load(open(f"{root}/src/data/region_map/region_map_sections.json"))["map_sections"]
+tmpl = open(f"{root}/src/data/region_map/region_map_sections.constants.json.txt").read()
+body = "".join(f"    {s['id']},\n" for s in secs)
+start = tmpl.index("## for map_section in map_sections\n")
+end = tmpl.index("## endfor\n") + len("## endfor\n")
+text = tmpl[:start] + body + tmpl[end:]
+text = text.replace("{{ doNotModifyHeader }}\n", "")
+open(f"{out}/constants/region_map_sections.h", "w").write(text)
diff --git a/dev_scripts/make_fairy_gfx.py b/dev_scripts/make_fairy_gfx.py
new file mode 100644
index 0000000..f607b9c
--- /dev/null
+++ b/dev_scripts/make_fairy_gfx.py
@@ -0,0 +1,105 @@
+"""Draw the FAIRY type icon and TM disc palette for the pokefirered hack.
+
+- graphics/interface/menu_info.png: a 32x12 "FAIRY" badge is composed in the
+  free slot at tile offset 0x04 (x=32, y=0) by reusing the NORMAL badge frame
+  and letter glyphs cut from the FIRE, DARK and FLYING badges.
+- graphics/interface/pokemon_types.pal: entry 10 (unused by every badge) becomes
+  the Fairy pink used as the badge fill.
+- graphics/tm_case/disc_types_2.pal: grows from 16 to 32 colours; the second
+  16 are a pink recolour of the Psychic disc palette for Fairy TMs.
+
+Usage: python3 -I make_fairy_gfx.py <pokefirered root>
+"""
+import sys
+from PIL import Image
+
+root = sys.argv[1]
+
+BG = 0             # transparent / outside the badge
+FILL_NORMAL = 25   # NORMAL badge fill colour index (16 + pal entry 9)
+FILL_FAIRY = 26    # 16 + pal entry 10, recoloured to pink below
+DARK, LIGHT = 30, 31
+FAIRY_PINK = (238, 153, 172)
+
+
+def tile_xy(offset):
+    return (offset % 16) * 8, (offset // 16) * 8
+
+
+def glyph(px, offset, x0, width):
+    """Return the letter columns [x0, x0+width) from rows 2..9 of a badge."""
+    ox, oy = tile_xy(offset)
+    return [[px[ox + x0 + dx, oy + y] for dx in range(width)] for y in range(2, 10)]
+
+
+def main():
+    png_path = f"{root}/graphics/interface/menu_info.png"
+    im = Image.open(png_path)
+    px = im.load()
+
+    letters = [
+        glyph(px, 0x24, 7, 5),   # F from FIRE
+        glyph(px, 0x8C, 11, 5),  # A from DARK
+        glyph(px, 0x24, 12, 4),  # I from FIRE
+        glyph(px, 0x24, 16, 5),  # R from FIRE
+        glyph(px, 0x60, 12, 4),  # Y from FLYING
+    ]
+    text_w = sum(len(g[0]) for g in letters)
+
+    dst_x, dst_y = tile_xy(0x04)
+    for x in range(32):
+        for y in range(12):
+            if px[dst_x + x, dst_y + y] != BG:
+                raise SystemExit("Fairy icon slot 0x04 is not empty")
+
+    # Copy the NORMAL frame, recoloured and with its text cleared.
+    src_x, src_y = tile_xy(0x20)
+    for x in range(32):
+        for y in range(12):
+            c = px[src_x + x, src_y + y]
+            if c == BG:
+                out = BG
+            elif 1 <= x <= 30 and 2 <= y <= 9:
+                out = FILL_FAIRY
+            else:
+                out = FILL_FAIRY if c == FILL_NORMAL else c
+            px[dst_x + x, dst_y + y] = out
+
+    # Stamp the letters, centred.
+    cur = (32 - text_w) // 2
+    for g in letters:
+        for y, row in enumerate(g):
+            for dx, c in enumerate(row):
+                if c in (DARK, LIGHT):
+                    px[dst_x + cur + dx, dst_y + 2 + y] = c
+        cur += len(g[0])
+    im.save(png_path)
+
+    # Recolour the unused type palette entry to Fairy pink.
+    pal_path = f"{root}/graphics/interface/pokemon_types.pal"
+    lines = open(pal_path).read().splitlines()
+    assert lines[0] == "JASC-PAL" and lines[2] == "16"
+    lines[3 + 10] = " ".join(map(str, FAIRY_PINK))
+    open(pal_path, "w").write("\n".join(lines) + "\n")
+
+    # TM case: add a 16-colour Fairy disc palette after Dragon.
+    disc1 = open(f"{root}/graphics/tm_case/disc_types_1.pal").read().splitlines()
+    psychic = [tuple(map(int, l.split())) for l in disc1[3 + 13 * 16: 3 + 14 * 16]]
+    # Keep transparency/outline/shading slots from the Psychic disc, replace
+    # the body gradient (3..9) and highlight (14) with a bubblegum pink.
+    body = [(255, 214, 236), (255, 198, 226), (252, 182, 216), (248, 166, 206),
+            (244, 150, 196), (238, 134, 186), (232, 118, 176)]
+    fairy = list(psychic)
+    fairy[3:10] = body
+    fairy[14] = (255, 248, 252)
+    disc2_path = f"{root}/graphics/tm_case/disc_types_2.pal"
+    disc2 = open(disc2_path).read().splitlines()
+    assert disc2[2] == "16"
+    disc2[2] = "32"
+    disc2 = disc2[:3 + 16] + [" ".join(map(str, c)) for c in fairy]
+    open(disc2_path, "w").write("\n".join(disc2) + "\n")
+    print("fairy gfx written; text width", text_w)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/dev_scripts/syntax_check.sh b/dev_scripts/syntax_check.sh
new file mode 100755
index 0000000..9e311eb
--- /dev/null
+++ b/dev_scripts/syntax_check.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# Syntax/type-check pokefirered C files with the host gcc (front end only, no
+# code generation, nothing from the decomp is executed).
+# Usage: syntax_check.sh <pokefirered root> <generated-headers dir> file.c...
+root=$1; gen=$2; shift 2
+cd "$root" || exit 1
+status=0
+for f in "$@"; do
+    out=$(gcc -m32 -fsyntax-only -std=gnu89 -D__INTELLISENSE__ -DFIRERED -DREVISION=0 -DENGLISH -DMODERN=0 \
+        -iquote include -iquote "$gen" -iquote gflib -Wimplicit -Wparentheses -Wdeclaration-after-statement -Werror=implicit-function-declaration \
+        -Wno-builtin-declaration-mismatch -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-attributes \
+        -Wno-pointer-to-int-cast -Wno-int-to-pointer-cast -Wno-overflow -Wno-multichar \
+        "$f" 2>&1 | grep -v -E "unknown escape sequence|initializer-string for array of .unsigned char. is too long|^ +[0-9]+ \\||^ +\\||In file included from|^ +from |: note: |In function|At top level")
+    if [ -n "$out" ]; then
+        echo "=== $f"; echo "$out" | grep -E "error|warning" | head -40; status=1
+    else
+        echo "ok  $f"
+    fi
+done
+exit $status
