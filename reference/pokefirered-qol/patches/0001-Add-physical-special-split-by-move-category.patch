From d4731d2e4e102dd728b6543cedc8af0fea68b58d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 19:37:47 +0000
Subject: [PATCH 1/6] Add physical/special split by move category

Each gBattleMoves entry now has a .category (DAMAGE_CATEGORY_PHYSICAL,
_SPECIAL or _STATUS) using the Gen 4+ classification. CalculateBaseDamage
picks Atk/Def vs SpA/SpD from the move instead of its type; weather and
Flash Fire now apply to physical Fire/Water moves too. Counter/Mirror Coat
bookkeeping, Hustle's accuracy drop and type-boosting held items follow
the move category. The old IS_TYPE_PHYSICAL/IS_TYPE_SPECIAL macros are
removed so stale type-based checks fail to compile.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EDbdFFZUtxJmCbg3V6KwVM
---
 include/battle.h             |   9 +-
 include/constants/pokemon.h  |   7 +
 include/pokemon.h            |   1 +
 src/battle_script_commands.c |  20 +-
 src/data/battle_moves.h      | 355 +++++++++++++++++++++++++++++++++++
 src/pokemon.c                |  23 ++-
 6 files changed, 394 insertions(+), 21 deletions(-)

diff --git a/include/battle.h b/include/battle.h
index ea91a3a..2b6a381 100644
--- a/include/battle.h
+++ b/include/battle.h
@@ -483,8 +483,13 @@ extern struct BattleStruct *gBattleStruct;
         typeArg = gBattleMoves[move].type;                            \
 }
 
-#define IS_TYPE_PHYSICAL(moveType)(moveType < TYPE_MYSTERY)
-#define IS_TYPE_SPECIAL(moveType)(moveType > TYPE_MYSTERY)
+// [QoL] Physical/Special split: the category is read from the move itself.
+// The old IS_TYPE_PHYSICAL/IS_TYPE_SPECIAL macros (type < / > TYPE_MYSTERY)
+// were removed on purpose so any leftover type-based check fails to compile.
+#define GET_MOVE_CATEGORY(move) (gBattleMoves[move].category)
+#define IS_MOVE_PHYSICAL(move)  (GET_MOVE_CATEGORY(move) == DAMAGE_CATEGORY_PHYSICAL)
+#define IS_MOVE_SPECIAL(move)   (GET_MOVE_CATEGORY(move) == DAMAGE_CATEGORY_SPECIAL)
+#define IS_MOVE_STATUS(move)    (GET_MOVE_CATEGORY(move) == DAMAGE_CATEGORY_STATUS)
 
 #define TARGET_TURN_DAMAGED ((gSpecialStatuses[gBattlerTarget].physicalDmg != 0 || gSpecialStatuses[gBattlerTarget].specialDmg != 0))
 
diff --git a/include/constants/pokemon.h b/include/constants/pokemon.h
index 21c6787..523a9e2 100644
--- a/include/constants/pokemon.h
+++ b/include/constants/pokemon.h
@@ -114,6 +114,13 @@
 #define TYPE_DARK           17
 #define NUMBER_OF_MON_TYPES 18
 
+// [QoL] Physical/Special split.
+// Each move now carries its own damage category (gBattleMoves[move].category)
+// instead of inheriting physical/special from its elemental type.
+#define DAMAGE_CATEGORY_PHYSICAL 0
+#define DAMAGE_CATEGORY_SPECIAL  1
+#define DAMAGE_CATEGORY_STATUS   2
+
 // Pokemon egg groups
 #define EGG_GROUP_NONE         0
 #define EGG_GROUP_MONSTER      1
diff --git a/include/pokemon.h b/include/pokemon.h
index 414dc41..9b5b941 100644
--- a/include/pokemon.h
+++ b/include/pokemon.h
@@ -246,6 +246,7 @@ struct BattleMove
     u8 target;
     s8 priority;
     u8 flags;
+    u8 category; // [QoL] DAMAGE_CATEGORY_PHYSICAL/SPECIAL/STATUS
 };
 
 #define SPINDA_SPOT_WIDTH 16
diff --git a/src/battle_script_commands.c b/src/battle_script_commands.c
