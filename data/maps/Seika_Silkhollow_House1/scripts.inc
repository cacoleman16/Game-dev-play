Seika_Silkhollow_House1_Text_Npc0::
	.string "I have woven silk for sixty years.\p"
	.string "The old songs say the first\n"
	.string "STARFALL left threads of light\l"
	.string "across the sky.\p"
	.string "So we weave a little star into\n"
	.string "every bolt of silk, for luck.$"
	.string "{JPN}{JPN}60ねん　きぬを　おって　きたんじゃよ。\p"
	.string "ふるい　うたに　よると　さいしょの\n"
	.string "スターフォールは　そらに　ひかりの　いとを\l"
	.string "のこしたそうじゃ。\p"
	.string "だから　ひとまき　ごとに　えんぎを　かついで\n"
	.string "ちいさな　ほしを　おりこむのじゃよ。$"

Seika_Silkhollow_House1_EventScript_Npc1::
	msgbox Seika_Silkhollow_House1_Text_Npc1, MSGBOX_NPC
	end

Seika_Silkhollow_House1_Text_Npc1::
	.string "Grandma's loom is older than\n"
	.string "this house!$"
	.string "{JPN}{JPN}おばあちゃんの　はたおりきは　この　いえより\n"
	.string "ふるいのよ！$"
