	end

Seika_Lanternport_LanternHall_Text_Worker::
	.string "We fold a thousand paper\n"
	.string "lanterns before the festival.\p"
	.string "My fingers are so tired!$"

Seika_Lanternport_LanternHall_EventScript_Man::
