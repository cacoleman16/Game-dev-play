Seika_Lanternport_LanternHall_MapScripts::
	.byte 0

Seika_Lanternport_LanternHall_EventScript_Chair::
	msgbox Seika_Lanternport_LanternHall_Text_Chair, MSGBOX_NPC
	end

Seika_Lanternport_LanternHall_Text_Chair::
	.string "I chair the STARWATCH FESTIVAL.\p"
	.string "Every town in SEIKA keeps a star\n"
	.string "shrine. The shrine keepers are\l"
	.string "our GYM LEADERS.\p"
	.string "Win all eight BADGES and the\n"
	.string "STARWATCH PLATEAU will open to\l"
	.string "you, below MT. SKYREACH.$"
	.string "{JPN}{JPN}わたしが　ほしみまつりの　いいんちょうです。\p"
	.string "セイカの　まちには　どこも　ほしの　やしろが\n"
	.string "あり　やしろの　もりびとが　ジムリーダーを\l"
	.string "つとめて　います。\p"
	.string "8つの　バッジを　すべて　あつめれば\n"
	.string "ソラトドキやまの　ふもと　ホシミこうげんへの\l"
	.string "みちが　ひらかれますよ。$"

Seika_Lanternport_LanternHall_EventScript_Worker::
	msgbox Seika_Lanternport_LanternHall_Text_Worker, MSGBOX_NPC
	end

Seika_Lanternport_LanternHall_Text_Worker::
	.string "We fold a thousand paper\n"
	.string "lanterns before the festival.\p"
	.string "My fingers are so tired!$"
	.string "{JPN}{JPN}おまつりの　まえに　かみの　ランタンを\n"
	.string "1000こ　おるのよ。\p"
	.string "もう　ゆびが　くたくた！$"

Seika_Lanternport_LanternHall_EventScript_Man::
	msgbox Seika_Lanternport_LanternHall_Text_Man, MSGBOX_NPC
	end

Seika_Lanternport_LanternHall_Text_Man::
	.string "The old songs say the WISHING\n"
	.string "STAR grants one wish when it\l"
	.string "wakes.\p"
	.string "What would you wish for?$"
	.string "{JPN}{JPN}ふるい　うたに　よると　ねがいぼしは　めざめた\n"
	.string "とき　ねがいを　1つ　かなえて　くれるんだって。\p"
	.string "きみなら　なにを　ねがう？$"
