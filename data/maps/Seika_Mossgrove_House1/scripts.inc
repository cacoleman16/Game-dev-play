	end

Seika_Mossgrove_House1_Text_Npc1::
	.string "I got stung once. Only once!\n"
	.string "Now I wear two hats.$"
	.string "{JPN}{JPN}いちど　さされたんだ。　1かいだけ！　だから\n"
	.string "いまは　ぼうしを　2つ　かぶってるの。$"
