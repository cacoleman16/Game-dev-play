	.byte 0

Seika_Inkbrush_House3_EventScript_Npc0::
	msgbox Seika_Inkbrush_House3_Text_Npc0, MSGBOX_NPC
	end

Seika_Inkbrush_House3_Text_Npc0::
	.string "Welcome to the brush school!\p"
	.string "We teach the old way: one breath,\n"
	.string "one stroke. SUMI studied here\l"
	.string "as a little girl.$"
	.string "{JPN}{JPN}しょどう　きょうしつへ　ようこそ！\p"
	.string "ここでは　むかしながらの　かきかたを　おしえて\n"
	.string "います。　ひといきで　ひとふで。　スミさんも\l"
	.string "ちいさい　ころ　ここで　ならったのよ。$"

Seika_Inkbrush_House3_EventScript_Npc1::
	msgbox Seika_Inkbrush_House3_Text_Npc1, MSGBOX_NPC
	end

Seika_Inkbrush_House3_Text_Npc1::
	.string "Today's word is STAR. It has\n"
	.string "nine strokes. I keep using ten!$"
	.string "{JPN}{JPN}きょうの　もじは　「ほし」。　9かく　なのに\n"
	.string "わたし　いつも　10かくに　なっちゃう！$"
