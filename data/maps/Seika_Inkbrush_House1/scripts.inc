	.byte 0

Seika_Inkbrush_House1_EventScript_Npc0::
	msgbox Seika_Inkbrush_House1_Text_Npc0, MSGBOX_NPC
	end

Seika_Inkbrush_House1_Text_Npc0::
	.string "A woman in a fine coat stayed in\n"
	.string "town last week.\p"
	.string "She paid in gold and spoke like\n"
	.string "a professor. Polite, but cold.\p"
	.string "She left for the west early one\n"
	.string "morning. Never said goodbye.$"
	.string "{JPN}{JPN}せんしゅう　りっぱな　コートを　きた　おんなが\n"
	.string "この　まちに　とまって　いったよ。\p"
	.string "きんかで　はらい　はかせの　ように　はなす\n"
	.string "ひとでね。　ていねいだが　つめたかったよ。\p"
	.string "ある　あさ　はやく　にしへ　でて　いったよ。\n"
	.string "さよならも　いわずにね。$"

Seika_Inkbrush_House1_EventScript_Npc1::
	msgbox Seika_Inkbrush_House1_Text_Npc1, MSGBOX_NPC
	end

Seika_Inkbrush_House1_Text_Npc1::
	.string "My grandma says shooting stars\n"
	.string "are wishes on their way down.$"
	.string "{JPN}{JPN}おばあちゃんが　いってたの。　ながれぼしは\n"
	.string "ねがいごとが　おりてくる　とちゅう　なんだって。$"
